<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- yara-x (Protection's malware engine) compiles rules with wasmtime, which makes its
	     generated code executable without MAP_JIT. Under the hardened runtime that page is
	     killed as "Code Signature Invalid" unless this is allowed. allow-jit alone is not enough. -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
