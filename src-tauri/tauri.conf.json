{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PenCleaner",
  "version": "0.1.0",
  "identifier": "com.pen.cleaner",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PenCleaner",
        "width": 1100,
        "height": 700,
        "minWidth": 960,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 24
        },
        "backgroundColor": "#1b1030",
        "visible": false
      },
      {
        "label": "menubar",
        "title": "PenCleaner",
        "url": "index.html?view=menubar",
        "width": 360,
        "height": 590,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "/Volumes/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "files": {
        "Library/LaunchAgents/com.pen.cleaner.login.plist": "LoginAgent.plist"
      }
    }
  }
}
