<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Open at Login. Registered with SMAppService from Settings, so it shows under PenCleaner
     in System Settings → Login Items. Starts PenCleaner in the menu bar, without its window. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.pen.cleaner.login</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/pencleaner</string>
	<key>ProgramArguments</key>
	<array>
		<string>pencleaner</string>
		<string>--background</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>AssociatedBundleIdentifiers</key>
	<string>com.pen.cleaner</string>
</dict>
</plist>
